#!/usr/bin/env bash
# Usage: bin/usage [YYYY-MM-DD] [YYYY-MM-DD]
#
# Workers AI neurons spent on the account, per model, for one UTC day or a range
# (default: today). This is the budget check for a run: note the UTC date and time
# you start it, run this afterwards, and compare with the run's own ai-usage.log.
# Needs CLOUDFLARE_API_TOKEN (account analytics read) and CLOUDFLARE_ACCOUNT_ID.
set -euo pipefail
: "${CLOUDFLARE_API_TOKEN:?}" "${CLOUDFLARE_ACCOUNT_ID:?}"
from=${1:-$(date -u +%F)}; to=${2:-$from}
q='query($a:String!,$f:Date!,$t:Date!){viewer{accounts(filter:{accountTag:$a}){aiInferenceAdaptiveGroups(limit:200,filter:{date_geq:$f,date_leq:$t}){dimensions{modelId date} sum{totalNeurons} count}}}}'
curl -s -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" -H 'Content-Type: application/json' \
  https://api.cloudflare.com/client/v4/graphql \
  -d "$(python3 -c 'import json,sys; print(json.dumps({"query":sys.argv[1],"variables":{"a":sys.argv[2],"f":sys.argv[3],"t":sys.argv[4]}}))' "$q" "$CLOUDFLARE_ACCOUNT_ID" "$from" "$to")" \
| python3 -c '
import sys,json
d=json.load(sys.stdin)
if d.get("errors"): print("ERR", d["errors"]); sys.exit(1)
rows=d["data"]["viewer"]["accounts"][0]["aiInferenceAdaptiveGroups"]; tot=0
for r in sorted(rows, key=lambda r:(r["dimensions"]["date"], r["dimensions"]["modelId"])):
    n=r["sum"]["totalNeurons"]; tot+=n
    print("%s  %-45s calls=%4d  neurons=%9.0f" % (r["dimensions"]["date"], r["dimensions"]["modelId"], r["count"], n))
print("total neurons: %.0f  = $%.4f at $0.011 per 1,000 (10,000 per day are free)" % (tot, tot/1000*0.011))'
